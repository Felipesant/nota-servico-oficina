{
    "version": 2,
    "builds": [
        {
            "src": "src/**/*",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist/frontend"
            }
        }
    ],
    "ignoreCommand": "rm -rf src/app/__mock__/*",
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}