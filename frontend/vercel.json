{
    "version": 4,
    "builds": [
        {
            "src": "src/**/*",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist/frontend"
            }
        }
    ],
    "routes": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}